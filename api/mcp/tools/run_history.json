{
  "name": "run_history",
  "status": "IMPLEMENTED",
  "milestone": "M1",
  "description": "The change records of one run of this agent, applied and refused, with the rows each change wrote (cascades included; values of resources the agent cannot read are redacted, values older than 30 days pruned). With from and to instead of runId, the reads this agent made outside any run in that period (the from and to of a LOOSE_READS item of list_runs). Newest first, cursor-paginated.",
  "inputSchema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "runId": {
        "type": "string",
        "format": "uuid",
        "description": "The run to list. Give runId, or from and to, not both."
      },
      "from": {
        "type": "string",
        "format": "date-time",
        "description": "With to: list the reads outside any run at or after this time (RFC 3339), instead of a run."
      },
      "to": {
        "type": "string",
        "format": "date-time",
        "description": "With from: only reads before this time. Must be after from."
      },
      "limit": {
        "type": "integer",
        "minimum": 1,
        "description": "Page size, default 50, clamped to 200."
      },
      "cursor": {
        "type": "string",
        "description": "nextCursor from the previous page."
      },
      "sort": {
        "type": "string",
        "pattern": "^-?id$",
        "description": "id or -id. Default -id (newest first)."
      }
    }
  },
  "outputSchema": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "items"
    ],
    "properties": {
      "items": {
        "type": "array",
        "items": {
          "$ref": "#/$defs/changeRecord"
        }
      },
      "nextCursor": {
        "type": "string",
        "description": "Absent on the last page."
      }
    },
    "$defs": {
      "changeRecord": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "changeId",
          "at",
          "actor",
          "op",
          "store",
          "rows",
          "cascadedRows",
          "status",
          "rowChanges"
        ],
        "dependentRequired": {
          "resource": [
            "shape"
          ],
          "shape": [
            "resource"
          ]
        },
        "properties": {
          "changeId": {
            "type": "string",
            "format": "uuid"
          },
          "at": {
            "type": "string",
            "format": "date-time"
          },
          "actor": {
            "type": "object",
            "required": [
              "kind",
              "name"
            ],
            "properties": {
              "kind": {
                "type": "string",
                "enum": [
                  "AGENT",
                  "PERSON"
                ]
              },
              "name": {
                "type": "string"
              },
              "runId": {
                "type": "string",
                "format": "uuid"
              },
              "taskId": {
                "type": "string",
                "format": "uuid"
              }
            }
          },
          "intent": {
            "type": "string"
          },
          "resource": {
            "type": "string",
            "description": "The request's own resource, in the store's form (schema.table in Postgres); absent when the action named none, and then shape is absent too."
          },
          "shape": {
            "type": "string",
            "enum": [
              "RECORD",
              "OBJECT"
            ],
            "description": "The kind of data the values describe (CONTRACT.md, Stores, Shapes)."
          },
          "key": {
            "type": [
              "object",
              "null"
            ],
            "description": "The identity fields of the one row the change targets, when it names one."
          },
          "op": {
            "type": "string",
            "enum": [
              "READ",
              "INSERT",
              "UPDATE",
              "DELETE",
              "OTHER",
              "REVERT"
            ],
            "description": "Basalt's operation (CONTRACT.md, Stores, Operations); the store's own word is store.verb."
          },
          "store": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "kind"
            ],
            "properties": {
              "kind": {
                "type": "string",
                "enum": [
                  "POSTGRES"
                ],
                "description": "The store's kind (CONTRACT.md, Stores)."
              },
              "verb": {
                "type": "string",
                "description": "The store's own word for the request's operation (CONTRACT.md, Stores, Operations): in Postgres the statement's command, SELECT for a read. Absent in exactly two cases: on REVERT, and on OTHER when the store did not give its command."
              }
            }
          },
          "request": {
            "type": "object",
            "additionalProperties": false,
            "description": "The request by family (CONTRACT.md, Stores, Request families). For SQL: statement and params; params pruned after 30 days.",
            "required": [
              "kind"
            ],
            "properties": {
              "kind": {
                "type": "string",
                "enum": [
                  "SQL"
                ]
              },
              "statement": {
                "type": "string"
              },
              "params": {
                "type": "array",
                "description": "Values bound to $1, $2, ...; pruned after 30 days."
              }
            }
          },
          "durationMs": {
            "type": "integer",
            "minimum": 0
          },
          "rows": {
            "type": "integer",
            "minimum": 0,
            "description": "Rows the action changed, cascaded rows included; for a READ, rows returned."
          },
          "cascadedRows": {
            "type": "integer",
            "minimum": 0
          },
          "status": {
            "type": "string",
            "enum": [
              "APPLIED",
              "APPROVAL_PENDING",
              "REFUSED",
              "APPROVAL_EXPIRED",
              "APPROVAL_WITHDRAWN",
              "REVERTED"
            ]
          },
          "reason": {
            "type": "object",
            "description": "Set when status is REFUSED.",
            "required": [
              "code"
            ],
            "properties": {
              "code": {
                "type": "string",
                "description": "Error code from CONTRACT.md."
              },
              "message": {
                "type": "string"
              }
            }
          },
          "rowChanges": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "resource",
                "shape",
                "op",
                "cascaded",
                "redacted",
                "pruned"
              ],
              "properties": {
                "resource": {
                  "type": "string",
                  "description": "What the row belongs to, in the store's form (schema.table in Postgres)."
                },
                "shape": {
                  "type": "string",
                  "enum": [
                    "RECORD",
                    "OBJECT"
                  ],
                  "description": "The kind of data the values describe (CONTRACT.md, Stores, Shapes)."
                },
                "op": {
                  "type": "string",
                  "enum": [
                    "INSERT",
                    "UPDATE",
                    "DELETE"
                  ]
                },
                "key": {
                  "type": [
                    "object",
                    "null"
                  ]
                },
                "before": {
                  "type": [
                    "object",
                    "null"
                  ]
                },
                "after": {
                  "type": [
                    "object",
                    "null"
                  ]
                },
                "cascaded": {
                  "type": "boolean"
                },
                "redacted": {
                  "type": "boolean"
                },
                "pruned": {
                  "type": "boolean"
                },
                "basedOn": {
                  "$ref": "#/$defs/basedOn",
                  "description": "UPDATE or DELETE of a row the run had read."
                },
                "blindWrite": {
                  "type": "boolean",
                  "description": "UPDATE or DELETE of a row the run never read: allowed and marked."
                },
                "largeValues": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "$ref": "../values/large-value.schema.json"
                  },
                  "description": "CONTRACT.md, Large values: the values (key, before, after) of this row left out because they are too large for you to read, each with its size and sha256; absent when none was. A value left out is absent from its object, never null: it is stored in full and a revert restores it from the stored row. An image with largeValues is not the whole row: never rebuild a row or a write from it."
                }
              }
            }
          },
          "basedOn": {
            "$ref": "#/$defs/basedOn",
            "description": "Set when the change wrote exactly one non-cascaded row and the run had read it."
          },
          "revertId": {
            "type": "string",
            "format": "uuid",
            "description": "On a revert's own record (op REVERT, actor PERSON): the revert it carried out."
          },
          "revertedBy": {
            "type": "array",
            "items": {
              "type": "string",
              "format": "uuid"
            },
            "description": "Revert changes that restored rows of this change. Status is REVERTED only when every row was restored; a partly reverted change stays APPLIED."
          },
          "largeValues": {
            "type": "array",
            "minItems": 1,
            "items": {
              "$ref": "../values/large-value.schema.json"
            },
            "description": "CONTRACT.md, Large values: the values (request.statement, request.params) of this record left out because they are too large for you to read, each with its size and sha256; absent when none was. A value left out is absent, never null: it is stored in full."
          }
        }
      },
      "basedOn": {
        "type": "object",
        "description": "The version of the row the run read before this write.",
        "required": [
          "version"
        ],
        "properties": {
          "version": {
            "type": "string",
            "minLength": 1,
            "description": "The store's version of the row, an opaque string the store writes and compares: xmin:<n> in Postgres (CONTRACT.md, Stores)."
          },
          "changeId": {
            "type": "string",
            "format": "uuid",
            "description": "The read (or earlier write) of this run that saw that version."
          }
        }
      }
    }
  },
  "errors": [
    "INVALID_ARGUMENT",
    "NOT_FOUND",
    "QUERY_TIMEOUT",
    "UNAVAILABLE",
    "INTERNAL"
  ]
}
