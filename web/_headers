# Cloudflare Pages headers for the portal. Keep the /* block identical to
# internal/websec (headers.go); TestPortalHeadersMatchEngine fails on drift.
# connect-src, script-src and the rest fall back to default-src 'self': the
# pages load only their own modules and fetch only their own origin.
/*
  Content-Security-Policy: default-src 'self'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'
  X-Frame-Options: DENY
  Referrer-Policy: no-referrer
  X-Content-Type-Options: nosniff

/*.js
  Content-Type: text/javascript
