{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://basaltvault.app/schemas/classify-review.v1.json",
  "title": "PII classification review",
  "description": "A review of every column's PII class, grouped by table: the classes and entity types the setup page's labels step writes. Never carries a value from the person's tables. See CONTRACT.md, PII classification.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "fingerprint",
    "review",
    "dryRun",
    "written",
    "tables"
  ],
  "properties": {
    "fingerprint": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$",
      "description": "Lowercase hex of pii_fingerprint() at this run."
    },
    "previousFingerprint": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$",
      "description": "Lowercase hex of pii_catalog.fingerprint before this run; absent before the first classify."
    },
    "review": {
      "type": "string",
      "enum": [
        "CHANGED",
        "ALL"
      ],
      "description": "The --review value that chose the columns shown."
    },
    "dryRun": {
      "type": "boolean"
    },
    "written": {
      "type": "boolean",
      "description": "Whether this run wrote classes (only with --yes or --set, never with --dry-run or --check)."
    },
    "tables": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/table"
      }
    }
  },
  "$defs": {
    "class": {
      "type": "string",
      "enum": [
        "PUBLIC",
        "IDENTIFIER",
        "FREE_TEXT",
        "SECRET",
        "UNCLASSIFIED"
      ]
    },
    "entityType": {
      "type": "string",
      "enum": [
        "EMAIL",
        "PHONE",
        "PERSON_NAME",
        "ADDRESS",
        "OTHER"
      ]
    },
    "table": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "table",
        "columns"
      ],
      "properties": {
        "table": {
          "type": "string",
          "description": "Schema-qualified table name, as stored (public.customers)."
        },
        "columns": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/column"
          }
        }
      }
    },
    "column": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "column",
        "dataType",
        "status",
        "class",
        "suggestedClass",
        "reason",
        "needsReview"
      ],
      "allOf": [
        {
          "description": "entityType is present exactly when class is IDENTIFIER.",
          "if": {
            "properties": {
              "class": {
                "const": "IDENTIFIER"
              }
            }
          },
          "then": {
            "required": [
              "entityType"
            ]
          },
          "else": {
            "not": {
              "required": [
                "entityType"
              ]
            }
          }
        },
        {
          "description": "suggestedEntityType is present exactly when suggestedClass is IDENTIFIER.",
          "if": {
            "properties": {
              "suggestedClass": {
                "const": "IDENTIFIER"
              }
            }
          },
          "then": {
            "required": [
              "suggestedEntityType"
            ]
          },
          "else": {
            "not": {
              "required": [
                "suggestedEntityType"
              ]
            }
          }
        },
        {
          "description": "phoneRegion only for a column whose entityType or suggestedEntityType is PHONE.",
          "if": {
            "not": {
              "anyOf": [
                {
                  "required": [
                    "entityType"
                  ],
                  "properties": {
                    "entityType": {
                      "const": "PHONE"
                    }
                  }
                },
                {
                  "required": [
                    "suggestedEntityType"
                  ],
                  "properties": {
                    "suggestedEntityType": {
                      "const": "PHONE"
                    }
                  }
                }
              ]
            }
          },
          "then": {
            "not": {
              "required": [
                "phoneRegion"
              ]
            }
          }
        }
      ],
      "properties": {
        "column": {
          "type": "string"
        },
        "dataType": {
          "type": "string",
          "description": "format_type(atttypid, NULL): the type without its modifier."
        },
        "status": {
          "type": "string",
          "enum": [
            "NEW",
            "UNCLASSIFIED",
            "TYPE_CHANGED",
            "NEEDS_REVIEW",
            "SUGGESTION_DIFFERS",
            "UNCHANGED"
          ],
          "description": "Why the column is shown, the first that applies. UNCHANGED only with --review=all."
        },
        "class": {
          "$ref": "#/$defs/class",
          "description": "The stored class; UNCLASSIFIED when the column has no row."
        },
        "entityType": {
          "$ref": "#/$defs/entityType",
          "description": "Present exactly when class is IDENTIFIER."
        },
        "suggestedClass": {
          "$ref": "#/$defs/class"
        },
        "suggestedEntityType": {
          "$ref": "#/$defs/entityType",
          "description": "Present exactly when suggestedClass is IDENTIFIER."
        },
        "reason": {
          "type": "string",
          "description": "Why it was suggested: names and counts only, never a value (NAME:email; SAMPLE:EMAIL 912/1000)."
        },
        "needsReview": {
          "type": "boolean",
          "description": "The suggestion is the protected guess for an ambiguous column; a person must look at it."
        },
        "phoneRegion": {
          "type": "string",
          "pattern": "^[A-Z]{2}$",
          "description": "ISO 3166-1 alpha-2 region the column's phone numbers parse as; only for PHONE, absent when none could be inferred."
        },
        "check": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "sampled",
            "roundTripFailures",
            "commonWordRule"
          ],
          "description": "With --check, for IDENTIFIER columns: the round-trip result over the sample.",
          "properties": {
            "sampled": {
              "type": "integer",
              "minimum": 0
            },
            "roundTripFailures": {
              "type": "integer",
              "minimum": 0
            },
            "commonWordRule": {
              "type": "integer",
              "minimum": 0,
              "description": "How many of the failures the common-word rule causes."
            }
          }
        }
      }
    }
  }
}
