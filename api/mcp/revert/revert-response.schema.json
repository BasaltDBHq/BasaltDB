{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://basaltvault.app/schemas/revert-response.v1.json",
  "title": "Revert response",
  "description": "What the revert page outputs, as the text basalt-revert.1.<base64url(this JSON)>. Byte fields are base64url without padding. Any relay may carry it; basalt_meta.apply_revert verifies it and runs the revert. See CONTRACT.md, Revert.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "revertId",
    "credentialId",
    "authenticatorData",
    "clientDataJson",
    "signature"
  ],
  "properties": {
    "revertId": {
      "type": "string",
      "format": "uuid"
    },
    "credentialId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]+$"
    },
    "authenticatorData": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]+$"
    },
    "clientDataJson": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]+$"
    },
    "signature": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]+$",
      "description": "ASN.1 DER ECDSA signature (ES256)."
    }
  }
}
