{
  "manifestVersion": 1,
  "name": "acme-ner",
  "version": "1.4.0",
  "publisher": "Acme",
  "description": "Finds names and addresses of people the database does not hold.",
  "protocol": [
    "basalt-plugin/1"
  ],
  "hooks": {
    "wire.detect": {
      "contract": "detector/1",
      "roles": [
        "VALUE",
        "NAME_CUE"
      ],
      "entityTypes": [
        "PERSON_NAME",
        "ADDRESS",
        "acme-ner.EMPLOYEE_ID"
      ]
    }
  },
  "endpoint": {
    "local": {
      "transport": "jsonrpc-stdio",
      "command": "bin/acme-ner",
      "args": [
        "--serve"
      ]
    }
  },
  "network": {
    "egress": []
  },
  "resources": {
    "memoryMB": 1024
  }
}
